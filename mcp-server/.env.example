NEXUSHUB_MODE=mock
MCP_TRANSPORT=streamable-http

MCP_HOST=127.0.0.1
MCP_PORT=8010
MCP_HTTP_PATH=/mcp

BACKEND_INTERNAL_URL=http://localhost:3001
INTERNAL_SERVICE_TOKEN=

LOG_LEVEL=warning
NEXUSHUB_ALLOWED_ORIGINS=*
NEXUSHUB_LOCAL_UPLOAD_DIR=uploads
NEXUSHUB_IMPORTANT_SENDERS=please,can you,approve,review,urgent,need your input,waiting for your response

# LangSmith Observability
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=nexushub
